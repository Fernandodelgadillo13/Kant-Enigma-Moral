rules_version = '2';
// ---------------------------------------------------------------------
// FASE 2 NO IMPLEMENTADA.
// Esta versión de la aplicación (Fase 1) no usa Firestore: guarda el
// progreso solo en el navegador (localStorage) y no envía datos a ningún
// servidor. Estas reglas niegan TODO acceso, de modo que, si alguien crea
// una base de datos Firestore en el proyecto, nadie pueda leer ni escribir.
// Si en el futuro se implementa la Fase 2 (Auth anónima para estudiantes,
// Google para docentes autorizados), estas reglas deben reemplazarse.
// ---------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
